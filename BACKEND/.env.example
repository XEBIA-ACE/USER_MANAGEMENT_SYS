# =============================================================================
# User Management System — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values before starting the
# server. Variables marked REQUIRED must be set; variables with defaults are
# optional and will fall back to the documented default if omitted.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_PATH=./data/app.db

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------

# Cost factor for bcrypt password hashing (must be >= 12)
BCRYPT_COST_FACTOR=12

# Bearer token used to authenticate admin API calls (REQUIRED)
ADMIN_BEARER_TOKEN=

# Base URL prepended to account-activation links sent in registration emails
ACTIVATION_BASE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Account Lockout (login brute-force protection)
# -----------------------------------------------------------------------------

# Number of consecutive failed login attempts before the account is temporarily locked
LOGIN_LOCKOUT_THRESHOLD=5

# Duration of the login lockout period in minutes (default: 15 minutes)
LOGIN_LOCKOUT_DURATION_MINUTES=15

# -----------------------------------------------------------------------------
# Password-Change Rate Limiting
# -----------------------------------------------------------------------------

# Maximum number of password change attempts allowed per user within the
# rate-limit window (default: 5)
PASSWORD_CHANGE_RATE_LIMIT_MAX=5

# Duration of the rate-limit window in seconds (default: 900 = 15 minutes)
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
TOKEN_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# OTP (One-Time Password)
# -----------------------------------------------------------------------------

# Length of the generated OTP code (default: 6)
OTP_LENGTH=6

# OTP validity period in minutes (default: 10)
OTP_TTL_MINUTES=10

# Maximum OTP verification attempts allowed per rate-limit window (default: 5)
OTP_MAX_ATTEMPTS_PER_WINDOW=5

# Duration of the OTP rate-limit window in minutes (default: 15)
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# Hashing algorithm used to store OTP values in Redis (default: sha256)
OTP_HASH_ALGORITHM=sha256

# Secret key used when hashing OTP values — keep this value private (REQUIRED)
OTP_HASH_SECRET=

# Set to "false" to disable OTP email delivery (useful for local dev/testing)
SMS_PROVIDER_ENABLED=true

# SendGrid dynamic template ID for OTP delivery emails (REQUIRED)
OTP_EMAIL_TEMPLATE_ID=

# -----------------------------------------------------------------------------
# Email / SendGrid
# -----------------------------------------------------------------------------

# SendGrid API key — never commit a real key (REQUIRED)
SENDGRID_API_KEY=

# SendGrid dynamic template ID for account-activation emails (REQUIRED)
SENDGRID_TEMPLATE_ID=

# Verified Single Sender address used as the "from" on all outgoing emails (REQUIRED)
FROM_EMAIL=

# Display name shown alongside FROM_EMAIL in email clients
FROM_NAME=User Management System

# -----------------------------------------------------------------------------
# Password Recovery
# -----------------------------------------------------------------------------

# Expiry window for password-recovery tokens in hours (default: 24)
PASSWORD_RECOVERY_TOKEN_EXPIRY_HOURS=24

# Base URL prepended to password-reset links sent in recovery emails
PASSWORD_RECOVERY_BASE_URL=http://localhost:5173

# SendGrid dynamic template ID for password-recovery emails (REQUIRED)
PASSWORD_RECOVERY_EMAIL_TEMPLATE_ID=

# -----------------------------------------------------------------------------
# Outbox Worker
# -----------------------------------------------------------------------------

# Interval between outbox polling cycles in milliseconds (default: 30000)
OUTBOX_POLL_INTERVAL_MS=30000

# Maximum number of delivery retries for a failed outbox email (default: 1)
OUTBOX_MAX_RETRIES=1