# ============================================================
# User Management System — Backend Environment Configuration
# Copy this file to .env and fill in the values before running.
# NEVER commit your actual .env file to version control.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
PORT=3000
DATABASE_PATH=./data/app.db
ACTIVATION_BASE_URL=http://localhost:5173/activate
ADMIN_BEARER_TOKEN=replace_with_a_secure_admin_token

# ------------------------------------------------------------
# Bcrypt
# ------------------------------------------------------------
BCRYPT_COST_FACTOR=12

# ------------------------------------------------------------
# Token expiry
# ------------------------------------------------------------
TOKEN_EXPIRY_HOURS=24

# ------------------------------------------------------------
# Outbox worker
# ------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=30000
OUTBOX_MAX_RETRIES=1

# ------------------------------------------------------------
# Session
# ------------------------------------------------------------
SESSION_SECRET=replace_with_a_secure_session_secret
SESSION_EXPIRY_SECONDS=86400

# ------------------------------------------------------------
# CSRF Protection
# A cryptographically random secret used to sign CSRF token HMACs.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
# ------------------------------------------------------------
CSRF_SECRET=replace_with_a_32_plus_character_random_secret

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# OTP
# ------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS_PER_WINDOW=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_HASH_ALGORITHM=sha256
OTP_HASH_SECRET=replace_with_a_secure_otp_hash_secret
SMS_PROVIDER_ENABLED=true
OTP_EMAIL_TEMPLATE_ID=replace_with_sendgrid_otp_template_id

# ------------------------------------------------------------
# SendGrid
# ------------------------------------------------------------
SENDGRID_API_KEY=replace_with_sendgrid_api_key
SENDGRID_TEMPLATE_ID=replace_with_sendgrid_activation_template_id
FROM_EMAIL=noreply@example.com
FROM_NAME=User Management System

# ------------------------------------------------------------
# Password recovery
# ------------------------------------------------------------
PASSWORD_RECOVERY_TOKEN_EXPIRY_HOURS=1
PASSWORD_RECOVERY_BASE_URL=http://localhost:5173/reset-password
PASSWORD_RECOVERY_EMAIL_TEMPLATE_ID=replace_with_sendgrid_recovery_template_id

# ------------------------------------------------------------
# Account lockout
# ------------------------------------------------------------
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_MINUTES=15