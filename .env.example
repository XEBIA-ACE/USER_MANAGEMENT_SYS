# SMTP configuration for emailService.js
# Copy this file to .env and fill in real values before running the application.

# SMTP server host (e.g. smtp.sendgrid.net, smtp.mailgun.org)
SMTP_HOST=smtp.mailtrap.io

# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Set to "true" only when using port 465 (implicit TLS)
SMTP_SECURE=false

# SMTP authentication credentials
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Connection pool settings (optional – defaults shown)
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# Sender identity shown in the "From" header
EMAIL_FROM_NAME=UMS Team
EMAIL_FROM_ADDRESS=no-reply@ums.example.com
