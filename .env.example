# Environment variables for the UMS backend
# Copy this file to .env and fill in real values before running.

# Server
PORT=3000

# JWT — MUST be a long, random secret in production (min 32 chars)
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1h

# Database (replace with real connection string)
# DATABASE_URL=postgres://user:password@localhost:5432/ums
